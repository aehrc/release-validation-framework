import org.ihtsdo.drools.domain.Concept
import org.ihtsdo.drools.domain.Relationship
import org.ihtsdo.drools.response.InvalidContent
import org.ihtsdo.drools.domain.Constants
import org.ihtsdo.drools.service.DescriptionService
import org.ihtsdo.drools.helper.ConceptHelper
import java.util.Collections
import org.ihtsdo.drools.response.Severity

global java.util.List invalidContent
global DescriptionService descriptionService

// A module difference is only a defect when nothing links the two modules. The
// faithful test is the module dependency refset (an active dependency in either
// direction), but no rule-visible service exposes it - refset members are not
// Drools facts. The closest equivalent available to a rule is that every
// extension module depends on the international core and model modules, so a
// pair where either side is international (ConceptHelper.isCoreModule) is always
// linked, and so is core <-> model. What remains is extension <-> extension,
// which is reported whether or not the pair declares a dependency.
rule "The relationships must have the same module as the source concept."
	dialect "mvel"
	when
		c : Concept(active)
		r : Relationship(active && moduleId != c.moduleId && sourceId == c.id && !axiomGCI
						&& !ConceptHelper.isCoreModule(moduleId) && !ConceptHelper.isCoreModule(c.moduleId))
	then
		invalidContent.add(new InvalidContent("26713930-fece-484d-ac9c-3e00b0e1090d",
				c, "The " + (r.characteristicTypeId == Constants.INFERRED_RELATIONSHIP ? "inferred" : "stated") + " relationship " + r.id + " has a different module (" + r.moduleId + " |" + (descriptionService.getFSNs(Collections.singleton(r.moduleId), Constants.US_EN_LANG_REFSET)).toString().replace("[", "").replace("]", "") +"|) than the source concept (" + c.moduleId + " |" + (descriptionService.getFSNs(Collections.singleton(c.moduleId), Constants.US_EN_LANG_REFSET)).toString().replace("[", "").replace("]", "") + "|).", Severity.WARNING));
end
 