            // An extension relationship on an international concept: what an extension is
            "id": "2",
            "moduleId": "900000000000207008", // "SNOMED CT core module"
            "relationships": [
                {
                    "destinationId": "a1",
                    "moduleId": "32506021000036107", // "SNOMED CT-AU module"
                    "typeId": "116680003" // is-a
                }
            ]
        },
        {
            // An extension override of an international concept keeps its international relationships
            "id": "2",
            "moduleId": "32506021000036107", // "SNOMED CT-AU module"
            "relationships": [
                {
                    "destinationId": "a1",
                    "moduleId": "900000000000207008", // "SNOMED CT core module"
                    "typeId": "116680003" // is-a
                }
            ]
        },
        {
            // Core and model modules: the core module depends on the model module
            "id": "2",
            "moduleId": "900000000000207008", // "SNOMED CT core module"
            "relationships": [
                {
                    "destinationId": "a2",
                    "characteristicTypeId": "900000000000011006",
                    "moduleId": "900000000000012004", // "SNOMED CT model component module"
                    "typeId": "116680003" // is-a
                }
            ]
        }
    ],
    "assertConceptsFail": [
