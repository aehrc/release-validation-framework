+// Registered product and trade names (AMT's ARTG-derived levels) legitimately
+// carry '&', '%' and '#' ("Bausch & Lomb", "Naphcon-A 0.025%"), and they sit in
+// three hierarchies:
+//   373873005 |Pharmaceutical / biologic product|  - MP/MPP and every AMT drug level
+//   774167006 |Product name|                       - AMT trade names (under Qualifier value)
+//   260787004 |Physical object|                    - AMT device levels
+// A hierarchy test rather than a semantic-tag list: the concept must actually
+// be in the hierarchy, so a mis-tagged concept elsewhere is still reported and
+// a new model level under one of the roots needs no reference-data change.
+function boolean isFsnInSpecialCharacterExemptHierarchy(Set statedAncestors, String conceptId) {
+	String[] roots = { "373873005", "774167006", "260787004" };
+	for (int i = 0; i < roots.length; i++) {
+		if (roots[i].equals(conceptId) || (statedAncestors != null && statedAncestors.contains(roots[i]))) {
+			return true;
+		}
+	}
+	return false;
+}
