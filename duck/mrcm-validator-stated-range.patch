@@ -0,0 +1,82 @@
+package org.snomed.quality.validator.mrcm;
+
+import org.junit.Test;
+import org.snomed.quality.validator.mrcm.model.Attribute;
+import org.snomed.quality.validator.mrcm.model.Domain;
+
+import java.io.File;
+import java.nio.file.Paths;
+import java.util.*;
+
+import static org.junit.Assert.*;
+
+/**
+ * The STATED run checks the source concept's stated relationships but judges
+ * whether the VALUE is in range on the INFERRED hierarchy.
+ *
+ * <p>Fixture: 35904009 is stated only under 71388002 |Procedure| and is
+ * classified under 386053000 |Evaluation procedure|. 1000011000168108 states
+ * Interprets = 35904009 (in range only by classification); 1000021000168100
+ * states Interprets = 404684003 |Clinical finding| (out of range both ways).
+ * The Relationship file also carries an inactive and an additional IS-A from
+ * 404684003 to 386053000, neither of which may put it in range.
+ */
+public class StatedRangeValidationTest {
+
+	private static final String INTERPRETS = "363714003";
+	private static final String IN_RANGE_ONLY_BY_CLASSIFICATION = "1000011000168108";
+	private static final long OUT_OF_RANGE = 1000021000168100L;
+
+	private final File releaseFiles = Paths.get("src/test/resources/statedRangeTestFiles").toFile();
+
+	@Test
+	public void statedValueInRangeOnlyByClassificationIsNotAViolation() throws Exception {
+		Assertion assertion = rangeAssertion(ContentType.STATED);
+		assertFalse(assertion.getCurrentViolatedConceptIds().contains(Long.parseLong(IN_RANGE_ONLY_BY_CLASSIFICATION)));
+		assertEquals(List.of(OUT_OF_RANGE), assertion.getCurrentViolatedConceptIds());
+	}
+
+	@Test
+	public void inferredFormJudgesTheSame() throws Exception {
+		assertEquals(List.of(OUT_OF_RANGE), rangeAssertion(ContentType.INFERRED).getCurrentViolatedConceptIds());
+	}
+
+	private Assertion rangeAssertion(ContentType contentType) throws Exception {
+		ValidationRun run = new ValidationRun(null, contentType, false);
+		run.setFullSnapshotRelease(true);
+		run.setValidationTypes(List.of(ValidationType.ATTRIBUTE_RANGE));
+		run.setUngroupedAttributes(new HashSet<>());
+		run.setConceptsUsedInMRCMTemplates(new HashSet<>(List.of(71388002L, 386053000L, 363714003L)));
+		run.setMRCMDomains(Map.of("71388002", interpretsDomain()));
+
+		new ValidationService().validateRelease(releaseFiles, run);
+
+		// Only ATTRIBUTE_RANGE runs, so every completed assertion is a range
+		// one; a second would be an invalid-concept or invalid-term finding.
+		List<Assertion> range = run.getCompletedAssertions().stream()
+				.filter(a -> a.getAttribute().getAttributeId().equals(INTERPRETS))
+				.toList();
+		assertEquals("one range assertion, no invalid-concept or invalid-term ones: " + range, 1, range.size());
+		return range.get(0);
+	}
+
+	private static Domain interpretsDomain() {
+		Domain domain = new Domain("71388002");
+		domain.setDomainConstraint("<< 71388002 |Procedure (procedure)|");
+		Attribute attribute = new Attribute(INTERPRETS, Constants.ALL_NEW_PRE_COORDINATED_CONTENT_CONCEPT);
+		attribute.setType(Attribute.Type.DOMAIN);
+		attribute.setGrouped("1");
+		attribute.setAttributeCardinality("0..*");
+		attribute.setAttributeInGroupCardinality("0..1");
+		attribute.setRuleStrengthId(Constants.MANDATORY);
+		domain.addAttribute(attribute);
+		Attribute range = new Attribute(INTERPRETS, Constants.ALL_NEW_PRE_COORDINATED_CONTENT_CONCEPT);
+		range.setType(Attribute.Type.RANGE);
+		range.setUuid(UUID.fromString("a107baf4-0000-0000-0000-000000000000"));
+		range.setRangeConstraint("<< 386053000 |Evaluation procedure (procedure)|");
+		range.setRangeRule("<< 71388002 |Procedure (procedure)|: [0..*] { [0..1] 363714003 |Interprets (attribute)| = << 386053000 |Evaluation procedure (procedure)| }");
+		range.setRuleStrengthId(Constants.MANDATORY);
+		domain.addAttributeRange(range);
+		return domain;
+	}
+}
