+package org.snomed.quality.validator.mrcm;
+
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import it.unimi.dsi.fastutil.longs.LongArrayList;
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import it.unimi.dsi.fastutil.longs.LongSet;
+import org.ihtsdo.otf.snomedboot.ReleaseImportException;
+import org.ihtsdo.otf.snomedboot.ReleaseImporter;
+import org.ihtsdo.otf.snomedboot.domain.ConceptConstants;
+import org.ihtsdo.otf.snomedboot.factory.ImpotentComponentFactory;
+import org.ihtsdo.otf.snomedboot.factory.LoadingProfile;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.Optional;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * The inferred IS-A hierarchy and nothing else, for the STATED run's
+ * attribute-range check.
+ *
+ * <p>The stated run judges a source concept on its stated relationships, but
+ * whether the VALUE is in range is a question about where that value sits, and
+ * international content reaches many ranges only by classification:
+ * 35904009 is stated under 71388002 |Procedure| and classified under
+ * 386053000 |Evaluation procedure|. Asked of the stated index alone,
+ * {@code Interprets = 35904009} fails {@code << 386053000} and is a false
+ * positive.
+ *
+ * <p>Held as parent -> children ids, read from the active inferred IS-A rows
+ * of the Relationship file, rather than as a second query index: that is all
+ * a disjunction of {@code <<}, {@code <} and self needs, and it is a few tens
+ * of megabytes against the gigabytes an index costs.
+ */
+final class InferredHierarchy {
+
+	private static final Logger LOGGER = LoggerFactory.getLogger(InferredHierarchy.class);
+
+	private static final Pattern TERM = Pattern.compile("\\|[^|]*\\|");
+	private static final Pattern OR = Pattern.compile("\\s+OR\\s+");
+	private static final Pattern FOCUS = Pattern.compile("(<<|<)?\\s*(\\d{6,18})");
+
+	/** Only the Relationship file; no concepts, descriptions or refsets. */
+	private static final LoadingProfile INFERRED_RELATIONSHIPS_ONLY = LoadingProfile.light
+			.withoutConcepts()
+			.withoutDescriptions()
+			.withoutTextDefinitions()
+			.withoutIdentifiers()
+			.withoutAnyRefsets()
+			.withoutInferredAttributeMapOnConcept()
+			.withoutStatedRelationships()
+			.withRelationships();
+
+	private final Long2ObjectOpenHashMap<LongArrayList> children = new Long2ObjectOpenHashMap<>();
+
+	private InferredHierarchy() {
+	}
+
+	/**
+	 * Loads with the same importer mode the query index uses, so that across
+	 * several snapshots, or snapshots and a delta, each relationship counts in
+	 * its effective state only.
+	 */
+	static InferredHierarchy load(Set<String> extractedRF2FilesDirectories, boolean fullSnapshotRelease) throws ReleaseImportException {
+		long start = System.currentTimeMillis();
+		InferredHierarchy hierarchy = new InferredHierarchy();
+		IsAFactory factory = hierarchy.new IsAFactory();
+		ReleaseImporter importer = new ReleaseImporter();
+		if (fullSnapshotRelease) {
+			importer.loadSnapshotReleaseFiles(extractedRF2FilesDirectories.iterator().next(), INFERRED_RELATIONSHIPS_ONLY, factory, false);
+		} else if (RF2ReleaseFilesUtil.anyDeltaFilesPresent(extractedRF2FilesDirectories)) {
+			importer.loadEffectiveSnapshotAndDeltaReleaseFiles(extractedRF2FilesDirectories, INFERRED_RELATIONSHIPS_ONLY, factory, false);
+		} else {
+			importer.loadEffectiveSnapshotReleaseFiles(extractedRF2FilesDirectories, INFERRED_RELATIONSHIPS_ONLY, factory, false);
+		}
+		LOGGER.info("Inferred IS-A hierarchy for the stated range check: {} edges under {} parents in {} ms",
+				factory.edges, hierarchy.children.size(), System.currentTimeMillis() - start);
+		return hierarchy;
+	}
+
+	/**
+	 * The concepts {@code rangeConstraint} selects on this hierarchy, or empty
+	 * when it is not a disjunction of {@code << id}, {@code < id} and
+	 * {@code id} - every MRCM range constraint at the time of writing - in
+	 * which case the caller must keep the stated judgement.
+	 */
+	Optional<LongSet> conceptsInRange(String rangeConstraint) {
+		String expression = TERM.matcher(rangeConstraint).replaceAll(" ").trim();
+		if (expression.startsWith("(") && expression.endsWith(")")) {
+			expression = expression.substring(1, expression.length() - 1).trim();
+		}
+		LongSet selected = new LongOpenHashSet();
+		for (String part : OR.split(expression)) {
+			Matcher focus = FOCUS.matcher(part.trim());
+			if (!focus.matches()) {
+				return Optional.empty();
+			}
+			long conceptId = Long.parseLong(focus.group(2));
+			String operator = focus.group(1);
+			if (operator == null || "<<".equals(operator)) {
+				selected.add(conceptId);
+			}
+			if (operator != null) {
+				addDescendants(conceptId, selected);
+			}
+		}
+		return Optional.of(selected);
+	}
+
+	private void addDescendants(long conceptId, LongSet selected) {
+		LongArrayList pending = new LongArrayList();
+		pending.add(conceptId);
+		while (!pending.isEmpty()) {
+			LongArrayList direct = children.get(pending.popLong());
+			if (direct == null) {
+				continue;
+			}
+			for (int i = 0; i < direct.size(); i++) {
+				long child = direct.getLong(i);
+				if (selected.add(child)) {
+					pending.add(child);
+				}
+			}
+		}
+	}
+
+	/**
+	 * Keeps active inferred IS-A rows. The profile drops inactive rows, and in
+	 * the effective modes the importer has already discarded superseded ones.
+	 */
+	private final class IsAFactory extends ImpotentComponentFactory {
+
+		private long edges;
+
+		@Override
+		public synchronized void newRelationshipState(String filename, long lineNumber, String id, String effectiveTime, String active, String moduleId,
+				String sourceId, String destinationId, String relationshipGroup, String typeId, String characteristicTypeId, String modifierId) {
+			if ("1".equals(active) && ConceptConstants.isA.equals(typeId) && ConceptConstants.INFERRED_RELATIONSHIP.equals(characteristicTypeId)) {
+				children.computeIfAbsent(Long.parseLong(destinationId), k -> new LongArrayList(4)).add(Long.parseLong(sourceId));
+				edges++;
+			}
+		}
+	}
+}
