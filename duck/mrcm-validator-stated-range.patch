+	/**
+	 * Loaded for a STATED run only, and only here, so a run without the range
+	 * check pays nothing and the hierarchy is released when the check ends.
+	 */
+	private InferredHierarchy inferredHierarchyForRange(Set<String> extractedRF2FilesDirectories, ValidationRun run) throws ReleaseImportException {
+		return ContentType.STATED.equals(run.getContentType())
+				? InferredHierarchy.load(extractedRF2FilesDirectories, run.isFullSnapshotRelease())
+				: null;
+	}
+
+	/**
+	 * The range for a STATED run's out-of-range query: the range constraint,
+	 * widened by the concepts it selects on the INFERRED hierarchy but not on
+	 * the stated one.
+	 *
+	 * <p>The source concept is still judged on its stated relationships - the
+	 * query runs on the stated index - but whether a VALUE is in range is a
+	 * fact about the value, and classification is what places much
+	 * international content: 35904009 is stated under 71388002 and only
+	 * classified under 386053000, so every stated {@code Interprets = 35904009}
+	 * failed {@code << 386053000} while the inferred run passed it.
+	 *
+	 * <p>Widening by explicit ids rather than replacing the constraint keeps
+	 * the query exactly as before whenever the two hierarchies agree on the
+	 * range: no extra ids, same string, same findings. A stated subsumption is
+	 * also an inferred one, so the union is the inferred range.
+	 *
+	 * <p>A constraint that is not a disjunction of {@code <<}, {@code <} and
+	 * self ids keeps the stated judgement, with a warning, rather than be
+	 * guessed at; no MRCM range constraint has another shape today.
+	 */
+	private String inRangeOnInferredHierarchy(SnomedQueryService queryService, InferredHierarchy inferredHierarchy, Attribute attributeRange) throws ServiceException {
+		String rangeConstraint = attributeRange.getRangeConstraint();
+		Optional<LongSet> inferredRange = inferredHierarchy.conceptsInRange(rangeConstraint);
+		if (inferredRange.isEmpty()) {
+			LOGGER.warn("Stated range check for attribute range {} judged on the stated hierarchy: unsupported range constraint '{}'",
+					attributeRange.getUuid(), rangeConstraint);
+			return rangeConstraint;
+		}
+		LongSet onlyInferred = new LongOpenHashSet(inferredRange.get());
+		for (Long statedInRange : queryService.eclQueryReturnConceptIdentifiers(rangeConstraint, 0, -1).conceptIds()) {
+			onlyInferred.remove(statedInRange.longValue());
+		}
+		if (onlyInferred.isEmpty()) {
+			return rangeConstraint;
+		}
+		long[] ids = onlyInferred.toLongArray();
+		Arrays.sort(ids);
+		LOGGER.info("Stated range check for attribute range {} ({}): {} values in range only on the inferred hierarchy",
+				attributeRange.getUuid(), rangeConstraint, ids.length);
+		StringBuilder widened = new StringBuilder(rangeConstraint.length() + ids.length * 22).append(rangeConstraint);
+		for (long id : ids) {
+			widened.append(" OR ").append(id);
+		}
+		return widened.toString();
+	}
