diff --git a/src/main/java/org/snomed/quality/validator/mrcm/SEPRefsetValidationService.java b/src/main/java/org/snomed/quality/validator/mrcm/SEPRefsetValidationService.java
index 4e14ecc..bed2d57 100644
--- a/src/main/java/org/snomed/quality/validator/mrcm/SEPRefsetValidationService.java
+++ b/src/main/java/org/snomed/quality/validator/mrcm/SEPRefsetValidationService.java
@@ -92,6 +92,27 @@ public class SEPRefsetValidationService {
         validateAllOrEntireConceptInSERefset(run, queryService, exclusionList);
         validateBodyStructureConcepts(run, queryService, bodyStructureConcepts);
         validateParentConceptsOfTargetComponents(run, queryService);
+        retainViolationsInModules(run);
+    }
+
+    // Every check above runs over the whole loaded edition. When the run is
+    // scoped to modules, keep only the findings whose flagged concept is in one
+    // of them - the same key LateralizableRefsetValidationService uses. The
+    // assertion itself stays registered, so one left with no findings reports
+    // as passed rather than disappearing from the run.
+    // A concept that could not be resolved carries no module; it is a dangling
+    // reference that cannot be attributed to any module, so it is kept.
+    private void retainViolationsInModules(ValidationRun run) {
+        Set<String> moduleIds = run.getModuleIds();
+        if (moduleIds == null || moduleIds.isEmpty()) return;
+        for (Assertion assertion : run.getCompletedAssertions()) {
+            if (SEPAssertionType.fromUUID(assertion.getUuid().toString()) == null) continue;
+            List<ConceptResult> inScope = assertion.getCurrentViolatedConcepts().stream()
+                    .filter(concept -> concept.getModuleId() == null || moduleIds.contains(concept.getModuleId()))
+                    .collect(Collectors.toCollection(ArrayList::new));
+            assertion.setCurrentViolatedConcepts(inScope);
+            assertion.setCurrentViolatedConceptIds(inScope.stream().map(ConceptResult::getId).map(Long::parseLong).collect(Collectors.toCollection(ArrayList::new)));
+        }
     }
 
     // 1. For active members, all referenced components and target components are active
